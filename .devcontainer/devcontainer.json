{
  "name": "Biblioteca Pessoal (teste Flask)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-test-app.sh",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Biblioteca Pessoal",
      "onAutoForward": "openBrowser"
    }
  }
}
